# y12.ai RMM - Environment Configuration
# Domain: rmm.y12.ai
# Optimized for Cloudflare Containers

IMAGE_REPO=tacticalrmm/
VERSION=latest

# ========================================
# GOOGLE OAUTH CONFIGURATION (REQUIRED)
# ========================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to Credentials > Create Credentials > OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Authorized JavaScript origins: https://rmm.y12.ai
# 7. Authorized redirect URIs: https://api.y12.ai/accounts/google/login/callback/

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_ONLY=True

# ========================================
# ADMIN CREDENTIALS (for initial setup only)
# ========================================
# After initial setup, use Google OAuth to login
TRMM_USER=admin
TRMM_PASS=changeme_on_first_login

# ========================================
# DOMAIN CONFIGURATION
# ========================================
# Primary domains for y12.ai deployment
APP_HOST=rmm.y12.ai
API_HOST=api.y12.ai
MESH_HOST=mesh.y12.ai

# Cookie domain (must encompass all 3 domains)
CSRF_COOKIE_DOMAIN=y12.ai
SESSION_COOKIE_DOMAIN=y12.ai

# ========================================
# PORT CONFIGURATION
# ========================================
# For Cloudflare, typically use standard ports
TRMM_HTTP_PORT=80
TRMM_HTTPS_PORT=443

# ========================================
# MESHCENTRAL CONFIGURATION
# ========================================
MESH_USER=meshcentral
MESH_PASS=changeme_secure_password
MONGODB_USER=mongouser
MONGODB_PASSWORD=changeme_mongo_password
MESH_PERSISTENT_CONFIG=0

# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_USER=y12rmm
POSTGRES_PASS=changeme_postgres_password

# ========================================
# SECURITY SETTINGS
# ========================================
# Disable web terminal for security (recommended for cloud deployment)
TRMM_DISABLE_WEB_TERMINAL=True

# Disable server side scripts for security (optional)
TRMM_DISABLE_SERVER_SCRIPTS=False

# SSO must be enabled for Google OAuth
TRMM_DISABLE_SSO=False

# ========================================
# SSL CERTIFICATES
# ========================================
# For Cloudflare, you can use origin certificates
# Base64 encoded certificates (optional, will auto-generate if not set)
# CERT_PUB_KEY=base64_encoded_public_cert
# CERT_PRIV_KEY=base64_encoded_private_key

# ========================================
# CLOUDFLARE SPECIFIC SETTINGS
# ========================================
# Cloudflare will terminate SSL, so internal traffic can be HTTP
# However, keep HTTPS for origin security

# Real IP header from Cloudflare
REAL_IP_HEADER=CF-Connecting-IP
